# Copia este archivo como ".env" y completa los valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore).

# Conexión a la base de datos (Supabase / PostgreSQL)
DATABASE_URL=

# Clave para firmar las cookies de sesión
SECRET_KEY=

# Usuarios de la pantalla de entrada.
# Si faltan, la app arranca en modo demostración.
ADMIN_CORREO=
ADMIN_CLAVE=
USUARIO_CORREO=
USUARIO_CLAVE=
